{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2020", "DOM"],
    // TypeScript 6 loads no `@types/*` packages unless they are listed. The
    // app has none: vite/client comes in through src/vite-env.d.ts, and
    // Node.js types stay out because the app does not run in Node.js.
    "types": [],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",
    // `@/` is `src/`, as in vite.config.ts (shadcn-vue imports use it).
    // Paths are relative to this file; TypeScript 6 deprecates `baseUrl`.
    "paths": {
      "@/*": ["./src/*"]
    },
    // Build mode keeps what it learned between runs here, out of the tree.
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    // Off because a component generated by the shadcn-vue CLI has an unused
    // parameter (src/components/ui/chart/ChartLegendContent.vue), and the
    // generated files are not edited. ESLint's
    // `@typescript-eslint/no-unused-vars` reports unused parameters in the
    // rest of the code instead (eslint.config.ts).
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.vue"],
  "exclude": ["src/**/*.spec.ts"]
}
